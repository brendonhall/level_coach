{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://level-coach.local/schema/zone.schema.json",
  "title": "Level Coach zone",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "faction", "level", "continent", "new"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "faction": {"enum": ["Horde", "Alliance", "Contested"]},
    "level": {"type": "object", "additionalProperties": false, "required": ["min", "max"],
              "properties": {"min": {"type": "integer", "minimum": 1, "maximum": 60}, "max": {"type": "integer", "minimum": 1, "maximum": 60}}},
    "continent": {"enum": ["Eastern Kingdoms", "Kalimdor", "Other"]},
    "mapID": {"type": "integer"},
    "hubs": {"type": "array", "items": {"type": "string"}},
    "new": {"type": "boolean"},
    "verify": {"type": "string"},
    "sources": {"type": "array", "items": {"type": "string", "pattern": "^https?://"}}
  }
}
