{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://level-coach.local/schema/dungeon.schema.json",
  "title": "Level Coach dungeon",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "level", "zone", "new"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "level": {"type": "object", "additionalProperties": false, "required": ["min", "max"],
              "properties": {"min": {"type": "integer", "minimum": 1, "maximum": 60}, "max": {"type": "integer", "minimum": 1, "maximum": 60}}},
    "zone": {"type": "string"},
    "new": {"type": "boolean"},
    "access": {"type": "string"},
    "horde_quests_from": {"type": "array", "items": {"type": "string"}},
    "verify": {"type": "string"},
    "sources": {"type": "array", "items": {"type": "string", "pattern": "^https?://"}}
  }
}
